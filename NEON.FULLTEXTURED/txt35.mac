	;
	; CALC DIVS (FOR BIG WALLS DRAW	CODE)
MKDIVS:	MOV #DIVS,R0
	MOV #224.,R5	; 32..256
1$:	MOV #16.,R2
	SWAB R2
	MOV #257.,R4
	SUB R5,R4
	CALL SPDIV
	MOVB R2,(R0)+
	SOB R5,1$
	RET
	;
	; WRC TABLES (FOR SMALL	WALLS DRAW CODE)
WRCT:	.WORD 0
MKWRCS:	MOV #WRC+64.,R0
	MOV R0,R3
	MOV #32.,R5
1$:	CLR WRCT
	MOV R3,-(R0)
	MOV R0,-(SP)
	MOV R3,-(SP)
	MOV #4096.,R2		; 16.*256.
	MOV R5,R4		; /R5
	CALL SPDIV
	MOV (SP)+,R3
	MOV R5,R4
	;CLR R0
	MOV #127.,R0		; HALF TEXEL OFFS.
2$:	MOV R0,R1
	CLRB R1
	SWAB R1
	MOV #116064,(R3)+	; MOVB X(R0),X(R4)
	MOV R1,(R3)+
	MOV WRCT,(R3)+
	ADD #256.,WRCT
	ADD R2,R0
	SOB R4,2$
	MOV #207,(R3)+		; RET
	MOV (SP)+,R0
	SOB R5,1$
	RET
	;
	; MAKE TEXTURES
MKTD:	MOV #MTRLHV,R0
	CLR R1
	MOV #16.,R2
	MOV #177770,R4
1$:	CALL MKOO
	MOV R3,(R0)+
	INC R1
	SOB R2,1$
	RET
	;
	; MAKE SPRITES
MKTS:	CLR R4
	MOV #20.,R1
	CALL MKOO
	MOV R3,HNTRS+2
	MOV #21.,R1
	CALL MKOO
	MOV R3,AMMOS+2
	MOV #22.,R1
	CALL MKOO
	MOV R3,HITS+2
	RET
	;
	; HELPER FUNC
MKOO:	MOV R1,R3
	BIC R4,R3
	ASH #5,R3
	ADD MemoryPointer,R3
	RET
	;
	; MAKE FLOOR RENDER CODE
MKFL:	MOV #MNVSC,R5
	MOV #100000,R4
	SETPRECA	; 1st part
	MOV #35.,R0
	CALL MKFL1
	MOV #100000,R4
	SETPRECB	; 2nd part
	MOV #35.,R0
	CALL MKFL1
	MOV #100000,R4
	SETPRECC	; 3rd part
	MOV #34.,R0
	CALL MKFL1
	RET
	;
MKFL1:	MOV R5,-(SP)
	MOV #60000,R2		; TEXTURE ADDR.
	MOV #32.,R1
1$:	MOV #113737,(R4)+	; MOVB @#A,@#B
	MOV R2,(R4)+
	MOV R5,(R4)+
	ADD #256.,R5
	BIT #1,R1
	BEQ 3$
	ADD #256.,R2
3$:	SOB R1,1$
	MOV (SP)+,R5
	INC R5
	MOV #207,(R4)+		; RET
	SOB R0,MKFL1
	RET
	;
	; MAKE TEMPLATE	OF SPRITE PRESCALLERS
CLPSC:	SETPRECT
	MOV #PSCTAB,R0
	MOV #256.*31.,R1	; -1
1$:	MOV #116401,(R0)+	; MOVB 0(R4),R1
	CLR (R0)+		;
	MOV #1402,(R0)+		; BEQ X
	MOV #110160,(R0)+	; MOVB R1,X(R0)
	MOV R1,(R0)+		; 
	SUB #256.,R1
	BPL 1$
	MOV #207,(R0)+		; RTS PC
	RET
	;
	; PRECALCULATIONS
CALCD:	SETPRECT
	CALL MKDIVS
	CALL MKWRCS
;	CALL MKFLRC
	CALL MKTD
	CALL MKTS
	CALL MKFL
	CALL CLPSC
	RET
	;